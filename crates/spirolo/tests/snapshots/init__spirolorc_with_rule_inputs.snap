source: crates/spirolo/tests/init.rs
expression: checked_defaults(written)
---
// spirolo configuration — generated by `spirolo init`.
// Detected: pnpm · vitest 2.1.9 · msw 2.4.11.
// Every key below is documented in place; delete a key to accept spirolo's default.
{
  // spirolo reads MSW/nock handlers only from files these globs match. Empty keeps the
  // default: any file under a `mocks` or `msw` directory that imports the library.
  // Detected from the handler files the model already found.
  "handlers": ["src/mocks/handlers/**"],

  // The modules that own outbound network access — your API client, a fetch wrapper —
  // so a rule can tell a mock of your own client from a mock of a third party. These
  // are the specifiers this suite module-mocks most; uncomment the ones that are your
  // data layer, and set the scope below to the tests the rule should judge.
  "dataLayer": [
    // "@/supabaseClient"
  ],

  // Which test files `data-layer-mock` applies to: integration and container specs,
  // where the network should answer, not a pure unit test that legitimately stubs a
  // client. Globs, matched against the repo-relative path.
  "dataLayerScope": ["**/*.integration.*", "**/*.msw.*", "**/integration/**"],

  // The modules or JSON keys that define the base URLs your code calls, as `path#name`,
  // so a rule can fold a handler pattern against the URL production emits. These are
  // the constants and exports that read like a base URL; uncomment the real ones.
  "urlSources": [
    // "src/config/app#urlApi"
  ],

  // Assumed values for named environment variables, read from this file only and never
  // from your real environment, so a URL built from `process.env.API_VERSION` folds to
  // a comparable path. Empty by default; add `"API_VERSION": "v1"` and its kin.
  "env": {},

  // Markdown files whose testing claims `gate-truth` diffs against the real config
  // (for example "mutation score is ratcheted", "thresholds enforced"). These mention
  // a gate; uncomment the ones that make a claim about this suite.
  "claims": [
    // "docs/TESTING_PLAYBOOK.md"
  ],

  // Mutation reports spirolo reads for redundant-test, as globs relative to the root. The
  // default reads Stryker's own report path under any package; detected reports are
  // written in place. Delete a path to stop reading it.
  "inputs": { "mutation": ["**/reports/mutation/mutation.json"] },

  // Rule severities. Every rule the binary runs is listed with its default; change a
  // value to "error", "warn" or "info", or delete a line to keep the default.
  "rules": {
    "handler-drift": "<default-severity>",
    "generator-walk": "<default-severity>",
    "absence-anchor": "<default-severity>",
    "weak-assertion": "<default-severity>",
    "data-layer-mock": "<default-severity>",
    "fail-closed-setup": "<default-severity>",
    "gate-truth": "<default-severity>",
    "dead-skip": "<default-severity>",
    "duplicate-test": "<default-severity>",
    "redundant-test": "<default-severity>",
    "unused-mock": "<default-severity>",
    "orphan-test": "<default-severity>",
    "stale-snapshot": "<default-severity>",
    "flake-candidate": "<default-severity>",
    "flake-observed": "<default-severity>",
    "untested-hotspot": "<default-severity>",
  }
}

{
  "name": "carbon",
  "scripts": {
    "build": "lerna run build --stream --prefix && node tasks/generate-repo-structure.mjs",
    "ci-check": "carbon-cli ci-check",
    "clean": "lerna run clean && lerna clean --yes && rimraf node_modules",
    "doctoc": "doctoc --title '## Table of Contents'",
    "format": "prettier --cache --write '**/*.{js,md,mdx,scss,ts,tsx}' '!**/{build,es,lib,storybook,ts,umd}/**'",
    "format:diff": "prettier --list-different '**/*.{js,md,mdx,scss,ts,tsx}' '!**/{build,es,lib,storybook,ts,umd}/**' '!packages/components/**'",
    "lint": "eslint actions config packages",
    "lint:fix": "eslint --cache --fix --max-warnings 0 actions config packages",
    "lint:styles": "stylelint '**/*.scss' --report-needless-disables --report-invalid-scope-disables",
    "postinstall": "husky",
    "telemetry:config": "lerna run telemetry:config",
    "test": "cross-env BABEL_ENV=test jest",
    "test:scss-generator": "cross-env BABEL_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runTestsByPath packages/scss-generator/__tests__/scss-test.js --runInBand --testPathIgnorePatterns=packages/web-components/ --collectCoverage --collectCoverageFrom='packages/scss-generator/src/**/*.js' --coverageDirectory=coverage/scss-generator --coveragePathIgnorePatterns=packages/web-components/",
    "test:e2e": "cross-env BABEL_ENV=test jest -c jest.e2e.config.js"
  }
}

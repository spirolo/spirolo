{
  "name": "spirolo-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "node scripts/sync.mjs && next dev",
    "build": "node scripts/sync.mjs && next build",
    "start": "npx --yes serve@14 out",
    "check:public": "node scripts/check-public.mjs",
    "types:check": "node scripts/sync.mjs && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.18.4",
    "fumadocs-mdx": "15.5.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.5",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
